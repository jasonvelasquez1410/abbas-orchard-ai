# =================================================================
# THE ABBA'S ORCHARD SCHOOL - 24/7 AI AGENT ENVIRONMENT CONFIG
# =================================================================

# Server Port (Local Testing)
PORT=3000

# AI Model Selection ('gemini' or 'openai')
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Google Gemini API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Meta / Facebook Messenger Webhook Credentials (developers.facebook.com)
META_VERIFY_TOKEN=abbas_orchard_meta_verify_token_2026
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
META_APP_SECRET=your_facebook_app_secret_here

# -----------------------------------------------------------------
# Real-Time Admissions Lead Dispatch & Notifications
# -----------------------------------------------------------------

# 1. Webhook Destination (Google Sheets AppScript, Zapier, Make, Discord, Slack)
# Whenever a parent books a tour or drops contact info, JSON payload is POSTed here:
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/your_google_appscript_id/exec

# 2. Transactional Email Alerts (Resend.com API Key)
# Fires a beautifully formatted HTML email with parent phone, campus, and inquiry context
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=The Abba's Orchard Admissions <onboarding@resend.dev>
NOTIFICATION_EMAIL_TO=admission_application@theabbasorchard.edu.ph

# School Central Notification Inboxes (Campus Routing Fallback)
CENTRAL_ADMISSIONS_EMAIL=admission_application@theabbasorchard.edu.ph
ACCOUNTING_EMAIL=accounting@theabbasorchard.edu.ph
